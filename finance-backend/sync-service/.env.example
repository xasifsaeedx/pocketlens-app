# Sync-service environment. Copy to .env and fill in your own values.
# See README.md (the env-vars section) for the full reference.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=
# Service-role key — full access, server-side only. NEVER ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required — Fernet key encrypting Plaid secrets + access tokens at rest (see vault.py).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENC_KEY=

# ── Web app / CORS ───────────────────────────────────────────────────────────
# CORS allowlist for the browser web app — comma-separated origins, scheme included
# (e.g. https://app.example.com,http://localhost:5173)
WEB_ORIGINS=

# Shared secret the server-side scheduler presents (X-Trigger-Secret header) when
# it calls POST /internal/sync and /internal/daily. Required for scheduled syncs:
# Supabase pg_cron reads the same value from Vault (secret name
# pocketlens_trigger_secret) — see supabase/migrations/20260919000000_server_side_scheduler.sql.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIGGER_SECRET=

# ── Plaid (optional house credentials) ───────────────────────────────────────
# Optional legacy "house" Plaid fallback — per-user creds normally live
# Fernet-encrypted in the plaid_credentials table (see plaid_client.py / vault.py).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Sandbox secret for the house client_id; preferred over PLAID_SECRET when set
PLAID_SANDBOX_SECRET=
# Max active Items per Plaid developer account (default 10)
PLAID_ITEM_LIMIT=
# Public webhook receiver, e.g. https://your-api.example.com/webhook/plaid
PLAID_WEBHOOK_URL=
# This service's own /link URL for OAuth banks, e.g. https://your-api.example.com/link
PLAID_REDIRECT_URI=

# ── Sync cadence ─────────────────────────────────────────────────────────────
# Cooldown (days) between user-triggered full syncs (POST /backfill-all). Default 2.
FULL_SYNC_COOLDOWN_DAYS=

# ── Logging (see logging_setup.py) ───────────────────────────────────────────
# stdout format: json or text (local default); LOG_LEVEL default INFO
LOG_FORMAT=
LOG_LEVEL=
